# Local configuration only. Copy to ignored .dev.vars and supply your own values.
APP_ORIGIN=http://127.0.0.1:8787
TRACKING_ORIGIN=http://localhost:8798
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Real R2 direct upload requires an isolated cloud environment and matching MEDIA binding.
# Do not point local simulated metadata at a production bucket.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
