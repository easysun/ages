{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ages-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "APP_ENV": "local" },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/health",
      "/health/*",
      "/t",
      "/t/*",
      "/c",
      "/c/*",
      "/s",
      "/s/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ages-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ages-media-local" }],
  "kv_namespaces": [
    { "binding": "LINK_CACHE", "id": "00000000000000000000000000000001" }
  ],
  "env": {
    "development": {
      "name": "ages-development",
      "vars": {
        "APP_ENV": "development",
        "APP_ORIGIN": "https://app.development.invalid",
        "TRACKING_ORIGIN": "https://events.tracking-development.invalid",
        "APP_REGISTRABLE_DOMAIN": "development.invalid",
        "TRACKING_REGISTRABLE_DOMAIN": "tracking-development.invalid",
        "R2_ACCOUNT_ID": "REPLACE_CLOUDFLARE_ACCOUNT_ID",
        "R2_BUCKET_NAME": "REPLACE_DEVELOPMENT_R2_BUCKET"
      },
      "routes": [
        { "pattern": "app.development.invalid", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ages-development",
          "database_id": "REPLACE_DEVELOPMENT_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "REPLACE_DEVELOPMENT_R2_BUCKET" }
      ],
      "kv_namespaces": [
        { "binding": "LINK_CACHE", "id": "REPLACE_DEVELOPMENT_KV_ID" }
      ]
    },
    "preview": {
      "name": "ages-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_ORIGIN": "https://app.preview.invalid",
        "TRACKING_ORIGIN": "https://events.tracking-preview.invalid",
        "APP_REGISTRABLE_DOMAIN": "preview.invalid",
        "TRACKING_REGISTRABLE_DOMAIN": "tracking-preview.invalid",
        "R2_ACCOUNT_ID": "REPLACE_CLOUDFLARE_ACCOUNT_ID",
        "R2_BUCKET_NAME": "REPLACE_PREVIEW_R2_BUCKET"
      },
      "routes": [{ "pattern": "app.preview.invalid", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ages-preview",
          "database_id": "REPLACE_PREVIEW_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "REPLACE_PREVIEW_R2_BUCKET" }
      ],
      "kv_namespaces": [
        { "binding": "LINK_CACHE", "id": "REPLACE_PREVIEW_KV_ID" }
      ]
    },
    "production": {
      "name": "ages-production",
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://app.production.invalid",
        "TRACKING_ORIGIN": "https://events.tracking-production.invalid",
        "APP_REGISTRABLE_DOMAIN": "production.invalid",
        "TRACKING_REGISTRABLE_DOMAIN": "tracking-production.invalid",
        "R2_ACCOUNT_ID": "REPLACE_CLOUDFLARE_ACCOUNT_ID",
        "R2_BUCKET_NAME": "REPLACE_PRODUCTION_R2_BUCKET"
      },
      "routes": [
        { "pattern": "app.production.invalid", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ages-production",
          "database_id": "REPLACE_PRODUCTION_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "REPLACE_PRODUCTION_R2_BUCKET" }
      ],
      "kv_namespaces": [
        { "binding": "LINK_CACHE", "id": "REPLACE_PRODUCTION_KV_ID" }
      ]
    }
  }
}
