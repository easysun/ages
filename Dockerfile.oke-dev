FROM node:26.13.1-bookworm-slim

WORKDIR /app
RUN mkdir -p /data && chown node:node /app /data
USER node

# The container runs Wrangler's local simulator, not a production Cloudflare Worker.
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY --chown=node:node . .
RUN npm run build:client \
    && printf 'User-agent: *\nDisallow: /\n' > dist/client/robots.txt \
    && printf '/*\n  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet\n  Cache-Control: private, no-store\n  X-Content-Type-Options: nosniff\n  X-Frame-Options: DENY\n  Referrer-Policy: no-referrer\n' > dist/client/_headers

ENV HOME=/home/node \
    NODE_ENV=development
EXPOSE 8787
CMD ["/bin/sh", "deploy/oke-dev/start.sh"]
