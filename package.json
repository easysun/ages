{
  "name": "ages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "npm run build:client && wrangler dev --env \"\" --local --ip 127.0.0.1",
    "build": "npm run build:client && npm run build:worker",
    "db:migrate:local": "wrangler d1 migrations apply DB --env \"\" --local",
    "types": "wrangler types types/worker.d.ts --env-interface WorkerBindings --env \"\" --no-strict-vars",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:recovery-drill": "node --test tests/tools/recovery-drill.test.mjs",
    "test:trace-metrics": "node --test tests/tools/chromium-trace-metrics.test.mjs tests/tools/chromium-trace-cli.test.mjs",
    "check": "npm run build:client && npm run lint && npm run typecheck && npm run test && npm run test:recovery-drill && npm run test:trace-metrics && npm run test:demo && npm run build:worker && npm run build:tracking-worker && playwright test",
    "build:client": "vite build",
    "build:worker": "wrangler deploy --env \"\" --dry-run --outdir dist/worker",
    "build:tracking-worker": "wrangler deploy --config wrangler.tracking.jsonc --env \"\" --dry-run --outdir dist/tracking-worker",
    "dev:client": "vite build --watch",
    "test:e2e": "npm run build:client && playwright test",
    "preflight": "node scripts/release-preflight.mjs",
    "recovery:drill": "node scripts/recovery-drill.mjs",
    "deploy:preview": "npm run preflight -- preview --deploy",
    "deploy:production": "npm run preflight -- production --deploy",
    "dev:demo": "npm run build:client && node scripts/dev-demo.mjs",
    "test:demo": "node --test tests/tools/dev-demo.test.mjs"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "file-type": "22.1.1",
    "hono": "4.13.12",
    "image-size": "2.0.4",
    "jose": "6.2.12",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsqr": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.150.0"
  }
}
