{
  "name": "ages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "wrangler dev --env \"\" --local --ip 127.0.0.1",
    "build": "wrangler deploy --env \"\" --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --env \"\" --local",
    "types": "wrangler types types/worker.d.ts --env-interface WorkerBindings --env \"\"",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "hono": "4.13.12",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
